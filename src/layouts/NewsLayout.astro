---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout
  title={`${frontmatter.title} | Black Smoke`}
  description={frontmatter.description}
>
  <section class="news-post">
    <div class="container p-10 mt-10 m-auto">
      <div class="mb-[70px]">
        <a class="back-btn" href="/allnews">Volver a Noticias</a>
      </div>
      <div class="post-date pb-2">{frontmatter.date}</div>
      <h1 class="text-5xl mb-8">{frontmatter.title}</h1>
      <div class="content">
        <slot />
      </div>
    </div>
  </section>
</Layout>

<style>
  .news-post {
    background-color: rgb(14, 14, 14);
  }

  .container {
    width: 90% !important;
    max-width: 800px !important;
    margin: auto;
    padding: 4rem 0 4rem 0;
  }

  .post-date {
    color: white;
    font-size: 0.875rem;
  }

  h1 {
    color: white;
  }

  .content {
    color: white;
    font-size: 18px;
  }

  .content p {
    color: white;
    margin-bottom: 50px;
  }

  .back-btn {
    display: inline-block;
    border: 1px solid white;
    padding: 10px;
    color: white;
  }

  .back-btn:hover {
    background-color: white;
    color: black;
  }
</style>
