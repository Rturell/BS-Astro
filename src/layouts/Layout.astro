---
import { getImage } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MiniPlayer from "../components/MiniPlayer.astro";
import ogSource from "../img/Black_Smoke_2025_1.jpg";

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
}

const {
  title,
  description = "Sitio Web de la banda de Rock and Roll, Black Smoke",
  image = ogSource,
} = Astro.props;

const ogImage = await getImage({ src: image, width: 1200, height: 630 });
const ogImageURL = new URL(ogImage.src, Astro.url.origin).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  name: "Black Smoke",
  genre: "Rock",
  url: "https://blacksmoke.com.uy",
  image: ogImageURL,
  description:
    "Black Smoke es una banda de Rock de Montevideo, Uruguay, formada en 2014.",
  foundingDate: "2014",
  foundingLocation: {
    "@type": "Place",
    name: "Montevideo, Uruguay",
  },
  sameAs: [
    "https://www.instagram.com/blacksmokeuy",
    "https://www.facebook.com/blacksmokeuy",
    "https://twitter.com/blacksmokeuy",
    "https://open.spotify.com/artist/0zasdvklx3VEacoHL4fjnQ",
    "https://www.youtube.com/blacksmokeuy",
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="es_UY" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <ClientRouter />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <MiniPlayer />
  </body>
</html>

<style is:global>
  :root {
    --font-body: "Libre Franklin", sans-serif;
    --font-title: "Playfair Display SC", serif;

    --color-black: black;
    --color-black-light: rgb(48, 48, 48);
    --color-red: #912f2f;
    --color-yellow: #fac43d;
    --color-white: white;
    --color-text: rgb(48, 48, 48);
    --color-link: #b92323;
    font-family: var(--font-body);
    color: var(--color-text);
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 500px;
  }

  @media (min-width: 1024px) {
    html {
      scroll-padding-top: 130px;
    }
  }

  body {
    position: relative;
    min-height: 100vh;
    margin: 0;
    background-attachment: fixed;
    background-size: 100vw 100vh;
  }

  .container {
    width: 90% !important;
    max-width: 1450px !important;
    margin: auto;
    color: var(--color-text);
    padding: 8rem 0 8rem 0;
  }

  ::-webkit-scrollbar {
    display: none;
  }

  h1,
  h2 {
    font-family: var(--font-title);
    text-transform: uppercase;
    font-weight: 500;
    letter-spacing: 2px;
    line-height: 2rem;
  }

  p {
    line-height: 1.5;
  }

  a {
    text-decoration: none !important;
  }

  a:hover {
    text-decoration: underline;
  }

  li {
    list-style: none;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  hr {
    margin-bottom: 20px;
  }

  input,
  button {
    font-size: inherit;
    font-family: inherit;
  }

  button:focus:not(:focus-visible) {
    outline: none;
  }

  @media (min-width: 720px) {
    h1 {
      font-size: 2.4rem;
    }
  }

  .visually-hidden {
    border: 0;
    clip: rect(0 0 0 0);
    height: auto;
    margin: 0;
    overflow: hidden;
    padding: 0;
    position: absolute;
    width: 1px;
    white-space: nowrap;
  }

  .primary-btn {
    padding: 10px 10px;
    background-color: var(--color-black);
    color: var(--color-white) !important;
    height: fit-content;
    border: 1px solid var(--color-black);
    border-radius: 0;
    text-decoration: none;
  }

  .primary-btn:active,
  .primary-btn:focus-visible,
  .primary-btn:focus {
    background-color: var(--color-black);
    color: var(--color-white) !important;
    height: fit-content;
    border: 1px solid var(--color-black);
    border-radius: 0;
    box-shadow: 0 0 0 0.25rem rgba(1, 1, 1, 0.25);
  }
  .primary-btn:hover {
    background-color: var(--color-white);
    color: var(--color-black) !important;
    border: 1px solid var(--color-black);
  }

  .secondary-btn {
    padding: 10px 10px;
    background-color: var(--color-white);
    color: var(--color-black);
    height: fit-content;
    border: 1px solid var(--color-white);
    text-decoration: none;
  }

  .secondary-btn:active,
  .secondary-btn:focus-visible,
  .secondary-btn:focus,
  .secondary-btn:hover {
    background-color: var(--color-black);
    color: var(--color-white) !important;
    height: fit-content;
    border: 1px solid var(--color-white);
    border-radius: 0;
    box-shadow: 0 0 0 0.25rem rgba(1, 1, 1, 0.25);
  }
</style>
