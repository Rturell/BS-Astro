---
import Layout from "../layouts/Layout.astro";
import StickerMap from "../components/StickerMap.astro";
import { stickers } from "../data/stickers";
---

<Layout title="Mapa de Pegotines | Black Smoke">
  <section class="mapa-page">
    <div class="mapa-container">
      <header class="mapa-header">
        <h1 class="mapa-title">Black Smoke por el mundo</h1>

        <p class="mapa-intro">
          ¿Te vas de viaje o tenés algún amigo que se va de viaje? Pedinos
          pegotines!!
        </p>

        <p class="mapa-intro">
          ¿Vivís en otro país? Bajate el archivo original y pegalo vos mismo!
        </p>

        <div class="mapa-actions">
          <a
            href="mailto:blacksmokeuy@gmail.com?subject=Quiero%20pegotines%20de%20Black%20Smoke"
            class="btn-primary"
          >
            Pedir pegotín
          </a>
          <button class="btn-secondary" disabled>Descargar</button>
        </div>
      </header>

      <div class="mapa-card">
        <StickerMap stickers={stickers} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .mapa-page {
    min-height: 100vh;
    padding: 60px 20px 80px;
    color: #fff;
    background:
      radial-gradient(
        800px circle at 10% -10%,
        rgba(225, 29, 72, 0.18),
        transparent 40%
      ),
      radial-gradient(
        600px circle at 90% 20%,
        rgba(255, 120, 0, 0.15),
        transparent 45%
      ),
      linear-gradient(180deg, #0b0b0b 0%, #000 100%);
  }

  .mapa-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .mapa-header {
    max-width: 760px;
    margin-bottom: 64px;
  }

  .mapa-title {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    letter-spacing: 0.12em;
    line-height: 1.3;
    margin-bottom: 32px;
  }

  .mapa-intro {
    color: #cfcfcf;
    margin-bottom: 16px;
    line-height: 1.6;
  }

  .mapa-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 32px 0 24px;
  }

  .btn-primary,
  .btn-secondary {
    border-radius: 999px;
    padding: 14px 26px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-align: center;
  }

  .btn-primary {
    background: linear-gradient(135deg, #e11d48, #ff7a18);
    color: #fff;
    box-shadow:
      0 12px 35px rgba(225, 29, 72, 0.45),
      inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 55px rgba(225, 29, 72, 0.65);
  }

  .btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    opacity: 0.6;
    cursor: not-allowed;
  }

  .mapa-card {
    position: relative;
    padding: 16px;
    border-radius: 28px;
    background: linear-gradient(
      180deg,
      rgba(20, 20, 20, 0.9),
      rgba(10, 10, 10, 0.9)
    );
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
  }

  .mapa-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 28px;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(225, 29, 72, 0.6),
      rgba(255, 120, 0, 0.4),
      rgba(225, 29, 72, 0.6)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
</style>
