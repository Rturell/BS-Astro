      data-pswp-width="4604"
      data-pswp-height="3070"
      target="_blank"
    >
      <Image
        src={Diego1}
        alt="Diego Spinelli, batería de Black Smoke"
        width={700}
        height={467}
        loading="lazy"
      />
    </a>
    <!-- CaroMavi -->
    <a
      href={CaroMavi.src}
      data-pswp-width="5986"
      data-pswp-height="3984"
      target="_blank"
    >
      <Image
        src={CaroMavi}
        alt="Caro y Mavi en un show de Black Smoke"
        width={700}
        height={466}
        loading="lazy"
      />
    </a>
    <!-- Ro3 -->
    <a
      href={Ro3.src}
      data-pswp-width="4604"
      data-pswp-height="3070"
      target="_blank"
    >
      <Image
        src={Ro3}
        alt="Rodrigo Turell en vivo con Black Smoke"
        width={700}
        height={467}
        loading="lazy"
      />
    </a>
    <!-- GonzaAndres -->
    <a
      href={GonzaAndres.src}
      data-pswp-width="746"
      data-pswp-height="933"
      target="_blank"
    >
      <Image
        src={GonzaAndres}
        alt="Gonzalo Núñez y Andrés Nion en vivo con Black Smoke"
        width={559}
        height={700}
        loading="lazy"
      />
    </a>
    <!-- Andres2 -->
    <a
      href={Andres2.src}
      data-pswp-width="651"
      data-pswp-height="897"
      target="_blank"
    >
      <Image
        src={Andres2}
        alt="Andrés Nion en vivo con Black Smoke"
        width={508}
        height={700}
        loading="lazy"
      />
    </a>
    <!-- Diego2 -->
    <a
      href={Diego2.src}
      data-pswp-width="722"
      data-pswp-height="899"
      target="_blank"
    >
      <Image
        src={Diego2}
        alt="Diego Spinelli en vivo con Black Smoke"
