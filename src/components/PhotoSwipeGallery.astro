        loading="lazy"
      />
    </a>
    <!-- ModoCasona -->
    <a
      href={ModoCasona.src}
      data-pswp-width="4620"
      data-pswp-height="3072"
      target="_blank"
    >
      <Image
        src={ModoCasona}
        alt="Black Smoke en vivo"
        width={700}
        height={465}
        loading="lazy"
      />
    </a>
    <!-- todos -->
    <a
      href={todos.src}
      data-pswp-width="636"
      data-pswp-height="957"
      target="_blank"
    >
      <Image
        src={todos}
        alt="Toda la banda Black Smoke junta"
        width={350}
        height={350}
        loading="lazy"
      />
    </a>
  </div>
</div>

<style>
  #gallery {
    background-color: black;
    border-top: 4px solid var(--color-white);
    border-bottom: 8px solid var(--color-black);
  }

  h1 {
    color: white;
    text-align: center;
    margin-bottom: 70px;
  }

  #gallery-photoswipe {
    display: flex;
    flex-wrap: wrap;
  }

  #gallery-photoswipe a {
    flex: 50%;
    cursor: pointer;
  }

  @media (min-width: 600px) {
    #gallery-photoswipe a {
      flex: 33.3333%;
    }
  }

  @media (min-width: 768px) {
    #gallery-photoswipe a {
      flex: 15%;
    }
  }

  #gallery-photoswipe img {
    height: 218px;
    object-fit: cover;
    object-position: top;
  }

  @media (min-width: 768px) {
    #gallery-photoswipe img {
      height: 350px;
    }
  }
</style>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: "#gallery-photoswipe",
    children: "a",
    pswpModule: () => import("photoswipe"),
  });

  lightbox.init();
</script>
