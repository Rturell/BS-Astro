---
import { Image } from "astro:assets";
import Band2 from "../../src/img/BAND2.webp";
import Gonza from "../../src/img/gallery/Gonza.jpg";
import Ro2 from "../../src/img/gallery/Ro2.jpg";
import Andres from "../../src/img/gallery/Andres.jpg";
import Diego1 from "../../src/img/gallery/Diego1.jpg";
import CaroMavi from "../../src/img/gallery/CaroMavi.jpg";
import Ro3 from "../../src/img/gallery/Ro3.jpg";
import GonzaAndres from "../../src/img/gallery/GonzaAndres.jpeg";
import Andres2 from "../../src/img/gallery/AndresDos.jpg";
import Diego2 from "../../src/img/gallery/DiegoDos.jpg";
import ModoCasona from "../../src/img/ModoCasona.webp";
import todos from "../../src/img/gallery/todos.jpg";
---

<div id="gallery">
  <div id="gallery-photoswipe">
    <!-- Banda -->
    <a
      href={Band2.src}
      data-pswp-width="4060"
      data-pswp-height="2700"
      target="_blank"
    >
      <Image
        src={Band2}
        alt="Black Smoke, la banda completa"
        width={700}
        height={465}
        loading="lazy"
      />
    </a>
    <!-- Gonza -->
    <a
      href={Gonza.src}
      data-pswp-width="4604"
      data-pswp-height="3070"
      target="_blank"
    >
      <Image
        src={Gonza}
        alt="Gonzalo Núñez, voz de Black Smoke"
        width={700}
        height={467}
        loading="lazy"
      />
    </a>
    <!-- Ro2 -->
    <a
      href={Ro2.src}
      data-pswp-width="1432"
      data-pswp-height="1797"
      target="_blank"
    >
      <Image
        src={Ro2}
        alt="Rodrigo Turell, bajo de Black Smoke"
        width={558}
        height={700}
        loading="lazy"
      />
    </a>
    <!-- Andres -->
    <a
      href={Andres.src}
      data-pswp-width="1910"
      data-pswp-height="1272"
      target="_blank"
    >
      <Image
        src={Andres}
        alt="Andrés Nion, guitarra de Black Smoke"
        width={700}
        height={465}
        loading="lazy"
      />
    </a>
    <!-- Diego1 -->
    <a
